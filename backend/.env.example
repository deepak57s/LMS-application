# ── MongoDB ──
# Replace with your MongoDB Atlas connection string.
# Get it from: Atlas Dashboard → Connect → Drivers → Copy connection string
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/lms_db
MONGODB_URL=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/lms_db

# ── JWT ──
# A random secret string used to sign tokens. Change this to anything random.
# In production, use a long random string like: openssl rand -hex 32
JWT_SECRET=my-super-secret-key-change-me
